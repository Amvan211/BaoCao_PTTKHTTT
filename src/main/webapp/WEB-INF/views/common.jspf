<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" import="java.util.*,vn.edu.ptit.restman.Web" %>
<% String ctx=request.getContextPath(); String uri=request.getRequestURI(); boolean logged=session.getAttribute("role")!=null; %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>RestMan</title><link rel="stylesheet" href="<%=ctx%>/assets/app.css"></head><body>
<% if(logged){ %><aside class="sidebar"><div class="brand"><span class="brand-mark">♨</span><div><strong>RestMan</strong><small>Restaurant Manager</small></div></div>
<div class="nav-label">Tổng quan</div><nav><a class="<%=uri.equals(ctx+"/")?"active":""%>" href="<%=ctx%>/"><span class="nav-icon">⌂</span>Trang chủ</a></nav>
<% if("QUAN_LI".equals(session.getAttribute("role"))){ %><div class="nav-label">Quản lý nhà hàng</div><nav><a class="<%=uri.contains("/statistics")?"active":""%>" href="<%=ctx%>/manager/statistics"><span class="nav-icon">▥</span>Thống kê</a><a class="<%=uri.contains("/dishes")?"active":""%>" href="<%=ctx%>/manager/dishes"><span class="nav-icon">♨</span>Món ăn</a><a class="<%=uri.contains("/combos")?"active":""%>" href="<%=ctx%>/manager/combos"><span class="nav-icon">◇</span>Combo</a></nav><% } %>
<% if("KHO".equals(session.getAttribute("role"))){ %><div class="nav-label">Quản lý kho</div><nav><a class="<%=uri.contains("/import")?"active":""%>" href="<%=ctx%>/stock/import"><span class="nav-icon">⇩</span>Nhập kho</a><a class="<%=uri.contains("/suppliers")?"active":""%>" href="<%=ctx%>/stock/suppliers"><span class="nav-icon">▣</span>Nhà cung cấp</a></nav><% } %><div class="sidebar-note">Hệ thống quản lý nhà hàng<br>Phiên bản demo 1.0</div></aside>
<header class="topbar"><div class="page-context"><strong>Quản trị nhà hàng</strong><span>Theo dõi và vận hành tập trung</span></div><div class="account"><span class="avatar"><%=Web.safe(((String)session.getAttribute("name")).substring(0,1))%></span><div class="account-copy"><strong><%=Web.safe((String)session.getAttribute("name"))%></strong><span><%="QUAN_LI".equals(session.getAttribute("role"))?"Quản lý":"Nhân viên kho"%></span></div><form method="post" action="<%=ctx%>/logout"><input type="hidden" name="csrf" value="<%=Web.safe((String)session.getAttribute("csrf"))%>"><button class="logout">Đăng xuất</button></form></div></header><% } %><main>
<% if(request.getAttribute("message")!=null){ %><p class="alert"><%=Web.safe((String)request.getAttribute("message"))%></p><% } %>
<% if(request.getAttribute("error")!=null){ %><p class="alert"><%=Web.safe((String)request.getAttribute("error"))%></p><% } %>
<% if(request.getAttribute("success")!=null){ %><p class="ok"><%=Web.safe((String)request.getAttribute("success"))%></p><% } %>
