digraph G {graph [bgcolor="white",fontname="Arial",ranksep=.65,nodesep=.35];node [fontname="Arial",style="rounded,filled",fillcolor="#eff6ff",color="#64748b",shape=box];edge [fontname="Arial",color="#64748b"]; rankdir=LR;node[shape=ellipse]; manager[label="Nhân viên quản lí",shape=box,fillcolor="#dbeafe"]; stock[label="Nhân viên kho",shape=box,fillcolor="#dbeafe"];seller[label="Nhân viên bán hàng",shape=box,fillcolor="#dbeafe"];customer[label="Khách hàng",shape=box,fillcolor="#dbeafe"];stat[label="Thống kê / Món ăn / Combo"];warehouse[label="Nhập nguyên liệu / NCC"];sales[label="Nhận khách / Gọi món / Thanh toán"];online[label="Tìm món / Đặt bàn / Đặt món"];manager->stat;stock->warehouse;seller->sales;customer->online;}