digraph G {graph [bgcolor="white",fontname="Arial",ranksep=.65,nodesep=.35];node [fontname="Arial",style="rounded,filled",fillcolor="#eff6ff",color="#64748b",shape=box];edge [fontname="Arial",color="#64748b"]; rankdir=LR;manager[label="Nhân viên quản lí",shape=box,fillcolor="#dbeafe"];stat[label="Xem thống kê"];dish[label="Quản lý món ăn"];combo[label="Quản lý combo"];a[label="Món ăn / Nguyên liệu / Khách hàng / NCC"];b[label="Thêm / Sửa / Ngừng bán"];c[label="Tạo / Sửa / Ngừng áp dụng"];manager->stat;manager->dish;manager->combo;stat->a [label="chuyên biệt"];dish->b;combo->c;}