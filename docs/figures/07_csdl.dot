digraph G {graph [bgcolor="white",fontname="Arial",ranksep=.65,nodesep=.35];node [fontname="Arial",style="rounded,filled",fillcolor="#eff6ff",color="#64748b",shape=box];edge [fontname="Arial",color="#64748b"];rankdir=LR;node[shape=record];ncc[label="{NHA_CUNG_CAP|PK ma_nha_cung_cap}"];pn[label="{PHIEU_NHAP|PK ma_phieu_nhap\lFK ma_nha_cung_cap}"];ct[label="{CHI_TIET_PHIEU_NHAP|PK/FK ma_phieu_nhap\lPK/FK ma_nguyen_lieu}"];nl[label="{NGUYEN_LIEU|PK ma_nguyen_lieu\lso_luong_ton}"];mon[label="{MON_AN|PK ma_mon}"];order[label="{DON_GOI_MON|PK ma_don}"];detail[label="{CHI_TIET_DON_GOI_MON|PK/FK ma_don\lPK/FK ma_mon}"];ncc->pn [label="1:N"];pn->ct[label="1:N"];ct->nl[label="N:1"];order->detail[label="1:N"];detail->mon[label="N:1"];}