digraph G {graph [bgcolor="white",fontname="Arial",ranksep=.65,nodesep=.35];node [fontname="Arial",style="rounded,filled",fillcolor="#eff6ff",color="#64748b",shape=box];edge [fontname="Arial",color="#64748b"]; rankdir=LR;stock[label="Nhân viên kho",shape=box,fillcolor="#dbeafe"];imp[label="Nhập nguyên liệu"];sup[label="Quản lý nhà cung cấp"];a[label="Chọn NCC"];b[label="Lập phiếu + kiểm tra"];c[label="Lưu phiếu + cập nhật tồn"];d[label="Thêm / Sửa / Ngừng hợp tác"];stock->imp;stock->sup;imp->a;imp->b;b->c;sup->d;}